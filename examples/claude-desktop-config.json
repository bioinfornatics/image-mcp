{
  "_comment": "Add the 'mcpServers' block you need to your Claude Desktop config.",
  "_config_location_macos": "~/Library/Application Support/Claude/claude_desktop_config.json",
  "_config_location_windows": "%APPDATA%\\Claude\\claude_desktop_config.json",
  "_config_location_linux": "~/.config/Claude/claude_desktop_config.json",

  "mcpServers": {

    "image-mcp": {
      "_comment": "RECOMMENDED — bun x pulls the package automatically, no clone needed.",
      "command": "bun",
      "args": ["x", "--bun", "@bioinfornatics/image-mcp"],
      "env": {
        "IMAGE_PROVIDER": "openai",
        "IMAGE_API_KEY": "sk-replace-with-your-key",
        "IMAGE_MCP_TRANSPORT": "stdio",
        "IMAGE_LOG_LEVEL": "error"
      }
    },

    "image-mcp-pinned": {
      "_comment": "Pin a specific version for reproducibility.",
      "command": "bun",
      "args": ["x", "--bun", "@bioinfornatics/image-mcp@0.4.0"],
      "env": {
        "IMAGE_PROVIDER": "openai",
        "IMAGE_API_KEY": "sk-replace-with-your-key",
        "IMAGE_MCP_TRANSPORT": "stdio",
        "IMAGE_LOG_LEVEL": "error"
      }
    },

    "image-mcp-npx": {
      "_comment": "npx variant — for users without Bun installed.",
      "command": "npx",
      "args": ["-y", "@bioinfornatics/image-mcp"],
      "env": {
        "IMAGE_PROVIDER": "openai",
        "IMAGE_API_KEY": "sk-replace-with-your-key",
        "IMAGE_MCP_TRANSPORT": "stdio"
      }
    },

    "image-mcp-azure": {
      "_comment": "Azure AI Foundry provider via bun x.",
      "command": "bun",
      "args": ["x", "--bun", "@bioinfornatics/image-mcp"],
      "env": {
        "IMAGE_PROVIDER": "azure",
        "IMAGE_BASE_URL": "https://my-resource.openai.azure.com",
        "IMAGE_API_KEY": "replace-with-azure-key",
        "IMAGE_DEPLOYMENT": "my-gpt-image-deployment",
        "IMAGE_API_VERSION": "2025-04-01-preview",
        "IMAGE_MCP_TRANSPORT": "stdio",
        "IMAGE_LOG_LEVEL": "error"
      }
    },

    "image-mcp-together": {
      "_comment": "Together AI provider — FLUX models.",
      "command": "bun",
      "args": ["x", "--bun", "@bioinfornatics/image-mcp"],
      "env": {
        "IMAGE_PROVIDER": "together",
        "IMAGE_API_KEY": "replace-with-together-key",
        "IMAGE_MCP_TRANSPORT": "stdio",
        "IMAGE_LOG_LEVEL": "error"
      }
    },

    "image-mcp-custom": {
      "_comment": "Custom / OpenRouter — any OpenAI-compatible endpoint.",
      "command": "bun",
      "args": ["x", "--bun", "@bioinfornatics/image-mcp"],
      "env": {
        "IMAGE_PROVIDER": "custom",
        "IMAGE_BASE_URL": "https://openrouter.ai/api/v1",
        "IMAGE_API_KEY": "replace-with-your-key",
        "IMAGE_MODELS": "openai/dall-e-3,stability/stable-diffusion-3",
        "IMAGE_MCP_TRANSPORT": "stdio",
        "IMAGE_LOG_LEVEL": "error"
      }
    },

    "image-mcp-local": {
      "_comment": "From a local clone — useful for development / unreleased changes.",
      "command": "bun",
      "args": ["run", "/absolute/path/to/image-mcp/src/main.ts"],
      "env": {
        "IMAGE_PROVIDER": "openai",
        "IMAGE_API_KEY": "sk-replace-with-your-key",
        "IMAGE_MCP_TRANSPORT": "stdio"
      }
    },

    "image-mcp-docker-http": {
      "_comment": "Connect to a running Docker container via HTTP — requires mcp-remote proxy.",
      "_note": "Claude Desktop doesn't support remote HTTP MCP servers natively. Use mcp-remote: https://github.com/geelen/mcp-remote",
      "command": "npx",
      "args": ["mcp-remote", "http://localhost:3000/mcp"],
      "env": {}
    }

  }
}
